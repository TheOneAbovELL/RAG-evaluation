# Copy to .env and fill in only what you need. Everything is optional:
# without OPENAI_API_KEY the workbench runs fully offline (BM25 + extractive baseline + lexical metrics).

# OpenAI access for the openai provider, embedding retriever and DeepEval judge metrics.
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Models
# RAGWB_GENERATOR_MODEL=gpt-4o
# RAGWB_EMBEDDING_MODEL=text-embedding-3-large
# RAGWB_JUDGE_MODEL=gpt-4o

# Reliability
# RAGWB_REQUEST_TIMEOUT_S=60
# RAGWB_MAX_RETRIES=3
# RAGWB_RETRY_BASE_DELAY_S=1
# RAGWB_MAX_WORKERS=4

# Optional cost tracking, USD per one million tokens (left unset: cost is reported as unknown).
# RAGWB_PRICE_INPUT_PER_MTOK=
# RAGWB_PRICE_OUTPUT_PER_MTOK=

# Locations (relative paths are resolved against the project root; RAGWB_HOME overrides the root itself)
# RAGWB_HOME=
# RAGWB_DATA_DIR=data
# RAGWB_DATASET=examples/datasets/honeybees.jsonl
# RAGWB_DOCUMENT=examples/documents/honeybees.pdf

# Input limits
# RAGWB_MAX_DATASET_BYTES=5000000
# RAGWB_MAX_DOCUMENT_BYTES=25000000
# RAGWB_MAX_CASES=5000
# RAGWB_MAX_FIELD_CHARS=20000

# RAGWB_LOG_LEVEL=INFO

# Per-case time limit in seconds; a stuck case is abandoned and recorded as an error (default 600, max 3600).
# RAGWB_CASE_TIMEOUT_S=600

# Log format: text (default) or json (one object per line, for log collectors). Secrets are redacted in both.
# RAGWB_LOG_FORMAT=text

# Optional shared password for the web app. Set this whenever the app is reachable by anyone but you
# (for example when started with --host 0.0.0.0). Compared in constant time; 5 failures per minute lock sign-in.
# RAGWB_APP_PASSWORD=

# Using another OpenAI-compatible provider (for example xAI Grok) instead of OpenAI: put that provider's key in
# OPENAI_API_KEY, set the base URL and use model names from the provider's own console. Never commit the key.
# OPENAI_BASE_URL=https://api.x.ai/v1
# RAGWB_GENERATOR_MODEL=<grok model name>
# RAGWB_JUDGE_MODEL=<grok model name>
# Use --retriever bm25 unless the provider offers an embeddings endpoint and you set RAGWB_EMBEDDING_MODEL for it.

# Optional local sentence-embedding model for the semantic metrics (needs `uv sync --extra semantic`; the first use
# downloads the model from its public hub; no project data is sent anywhere).
# RAGWB_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Space model operations (answers, judge measurements) to stay under a provider's request quota. One judge measurement can
# make several API calls, so choose a value well below the quota. Unset = no pacing.
# RAGWB_MAX_REQUESTS_PER_MINUTE=12

# With named accounts: shared (default, everyone sees every run) or own (non-admins see only runs they started, plus runs
# with no owner such as the example runs).
# RAGWB_RUN_VISIBILITY=shared

# RAGWB_NO_DOTENV=1 makes the loader ignore this file entirely (the test suite sets it so a real key never reaches a test).
