# Normalise line endings in the repository; checkouts use the platform default.
* text=auto

*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
uv.lock text eol=lf -diff

# Binary files: never convert, never diff as text.
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.db  binary
